# JARVIS backend - environment configuration template.
#
# IMPORTANT: this file contains PLACEHOLDERS ONLY - never real credentials.
# Copy it to .env in this same folder and fill in the real values there;
# .env is never committed/shared and JARVIS reads it automatically
# (app/config.py, class Config: env_file = ".env").
#
# This is the first .env.example this project has had (added 2026-09-21,
# alongside the Multi-Model AI Brain upgrade - see progress-tracker.md) -
# it documents every setting app/config.py currently reads, not just the
# new AI-provider ones, since none existed before. See app/config.py itself
# for the full, authoritative comment on each setting's history and
# reasoning - the notes below are a shorter pointer to that, not a
# replacement for it.

# --- Core / database / auth (required) -------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/jarvis
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI providers ------------------------------------------------------------
# Claude / Anthropic (the ORIGINAL, single-provider setup - kept unchanged).
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Multi-Model AI Brain upgrade (added 2026-09-21 - see AI_PROVIDERS.md for
# the full picture). AI_PRIMARY_PROVIDER/AI_SECONDARY_PROVIDER/AI_TERTIARY_
# PROVIDER set the fallback chain order; each value is one of "anthropic",
# "gemini", "groq". Defaults to anthropic -> gemini -> groq (Claude stays
# the live default for now, per Sudeep's own choice - see
# ai_provider.py's AIProviderManager docstring for why). A provider left
# with no API key below is automatically skipped, not a startup failure -
# add Gemini/Groq keys whenever ready.
AI_PRIMARY_PROVIDER=anthropic
AI_SECONDARY_PROVIDER=gemini
AI_TERTIARY_PROVIDER=groq
AI_MAX_RETRIES=1
AI_REQUEST_TIMEOUT_MS=60000

# Google Gemini. Get a key from https://aistudio.google.com/apikey (or your
# Google Cloud project's Vertex/Gemini API credentials). Model ID verified
# against ai.google.dev's own current model list on 2026-09-21.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Groq. Get a key from https://console.groq.com/keys. Model IDs verified
# against console.groq.com's own current model list on 2026-09-21.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Web search (Phase 8) ---------------------------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=3

# --- Memory (Phase 9) -------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_MAX_RECALL=40

# --- Knowledge base / document Q&A (Phase 10) -------------------------------
# NOTE: this feature is currently Claude/Anthropic-only regardless of the AI
# provider chain above (see AI_PROVIDERS.md's "Known gaps" section) - keep
# an Anthropic API key configured somewhere in the chain for it to work.
KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_MAX_UPLOAD_MB=20

# --- Universal Skill Engine (Phase 11) --------------------------------------
SKILL_ENGINE_ENABLED=true
SKILL_MAX_ACTIVE_RECALL=5
SKILL_CONTEXT_CHARS_PER_SKILL=3000

# --- Tally billing integration (custom feature) -----------------------------
TALLY_ENABLED=true
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY_NAME=Your Company Name As It Appears In Tally
TALLY_SALES_LEDGER=Sales
TALLY_NEW_CUSTOMER_GROUP=Sundry Debtors
TALLY_TIMEOUT_SECONDS=15
TALLY_IGST_LEDGER=OUTPUT IGST
TALLY_CGST_LEDGER=OUTPUT CGST
TALLY_SGST_LEDGER=OUTPUT SGST
TALLY_COMPANY_GSTIN=00XXXXX0000X0ZX
TALLY_COMPANY_STATE=Your State
TALLY_COMPANY_GST_REGISTRATION_NAME=Your GST Registration Name

# --- Agent Factory (custom feature) -----------------------------------------
AGENT_FACTORY_ENABLED=true
AGENT_MAX_ACTIVE=10

# --- Debugging Agent (Phase 13) ---------------------------------------------
DEBUG_AGENT_ENABLED=true

# --- Self-diagnostics / self-healing (Phases 14/15) -------------------------
HEALTH_CHECK_ENABLED=true

# --- Tool/plugin architecture (Phase 16) ------------------------------------
TOOL_REGISTRY_ENABLED=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_SECRETS_KEY=
TOOL_CALL_TIMEOUT_SECONDS=15
TOOL_MAX_RESPONSE_CHARS=8000

# --- AI agent orchestration / consult (Phase 17) ----------------------------
AGENT_CONSULT_ENABLED=true

# --- Automation (Phase 18) ---------------------------------------------------
AUTOMATION_ENGINE_ENABLED=true
AUTOMATION_CHECK_INTERVAL_SECONDS=60

# --- Email + Calendar (Phase 19) --------------------------------------------
# Requires a Google Cloud Console OAuth Client ID (see progress-tracker.md /
# the setup steps JARVIS gave you): enable the Gmail API + Google Calendar
# API on a Google Cloud project, configure the OAuth consent screen (External
# user type, add yourself as a test user), then create an OAuth 2.0 Client ID
# (Web application type) with GOOGLE_OAUTH_REDIRECT_URI below as its exact
# Authorized redirect URI. No new encryption key is needed - this reuses
# TOOL_SECRETS_KEY above (Phase 16) to encrypt the stored Google tokens.
EMAIL_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# --- Incoming phone agent (Phase 20) -----------------------------------------
# Requires a Twilio account (console.twilio.com) with a voice-capable phone
# number, and a public URL Twilio can reach this backend at while it's
# running (an ngrok tunnel for now - see the setup steps JARVIS gave you).
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are real credentials from the Twilio
# console (Account Info section) - never paste these into chat.
PHONE_AGENT_ENABLED=true
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The Twilio voice-capable number JARVIS uses as caller ID for approved
# outbound calls. Use E.164 format, e.g. +15551234567.
TWILIO_FROM_NUMBER=+15551234567
# Set false to temporarily block outbound calls even when Twilio is configured.
PHONE_AGENT_OUTBOUND_ENABLED=true

# --- Reminders (added 2026-09-26, Sudeep's explicit request) ----------------
# Sends a real SMS a bit before each upcoming Google Calendar event, using
# the SAME Twilio account/number configured just above - no second Twilio
# setup needed, only where to send it.
REMINDER_ENGINE_ENABLED=true
REMINDER_CHECK_INTERVAL_SECONDS=300
REMINDER_LEAD_MINUTES=60
# Sudeep's OWN phone (E.164 format, e.g. +919905719715) - distinct from
# TWILIO_FROM_NUMBER, which is the business line callers dial.
PHONE_AGENT_REMINDER_TO_NUMBER=
# The JARVIS account whose persona/settings a call uses - Twilio's webhook
# has no login of its own, so this has to be told which account it's for.
PHONE_AGENT_OWNER_EMAIL=you@example.com
# Your current ngrok URL (changes every time you restart ngrok on the free
# tier, unless you've reserved a static domain) - e.g.
# https://abcd-1234.ngrok-free.app - with NO trailing slash.
PHONE_AGENT_PUBLIC_BASE_URL=
# IANA timezone used when displaying incoming-call times.
PHONE_AGENT_TIMEZONE=Asia/Kolkata
PHONE_AGENT_VALIDATE_SIGNATURE=true
PHONE_AGENT_BUSINESS_NAME=SS Retail Services
# Leave blank to use the default "Hi, thanks for calling <business>. You're
# speaking with an AI assistant..." greeting, or set your own.
PHONE_AGENT_GREETING=
# Optional extra instructions folded into every phone call's persona (e.g.
# business hours, what to say if asked about pricing) - blank by default.
PHONE_AGENT_PERSONA=
PHONE_AGENT_LANGUAGE=en-IN
PHONE_AGENT_VOICE=Polly.Aditi
PHONE_AGENT_ALLOW_WEB_SEARCH=false
PHONE_AGENT_MAX_TURNS=15
# Keep below Twilio's webhook wait window. Code also enforces a 12-second cap.
PHONE_AGENT_REPLY_TIMEOUT_SECONDS=10
